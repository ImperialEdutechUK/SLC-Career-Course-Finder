# South London College Career & Course Finder - configuration inventory.
# Placeholders only. Never commit real secrets; use the platform secret store.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SLC_COURSE_ORIGIN=https://southlondoncollege.org
QUESTIONNAIRE_VERSION=2026-09-08.1

# Catalogue release (generated by `npm run prepare:catalogue`)
CATALOGUE_MANIFEST_URI=./data/generated/release-manifest.json

# Exact lowercase hostnames the engine may serve course links for.
ALLOWED_COURSE_URL_HOSTS=southlondoncollege.org

# Optional branches. Both stay OFF until reviewed content exists (see docs/AMBIGUITY-REGISTER.md).
CAREER_C7_ENABLED=false
COURSE_F6_ENABLED=false

# Optional integrations. All default OFF; the service is complete without them.
SESSION_RESTORE_ENABLED=false
SAVED_RESULTS_ENABLED=false
CONTACT_REQUESTS_ENABLED=false
MARKETING_OPT_IN_ENABLED=false
NONESSENTIAL_ANALYTICS_ENABLED=false
AI_EXPLANATIONS_ENABLED=false
