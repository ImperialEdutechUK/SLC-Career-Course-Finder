{
  "name": "slc-career-course-finder",
  "version": "1.0.0",
  "private": true,
  "description": "South London College Career & Course Finder",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:catalogue": "node scripts/publish-catalogue.mjs",
    "dev": "npm run prepare:catalogue && next dev",
    "build": "npm run prepare:catalogue && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run prepare:catalogue && npm run test:reference && npm run test:app",
    "test:reference": "node --test src/lib/engine/engine.test.mjs",
    "test:app": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
